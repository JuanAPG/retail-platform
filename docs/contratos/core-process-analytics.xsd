<?xml version="1.0" encoding="UTF-8"?>
<!-- Contrato XML de M09 analítica (Fase A). Espacio `core-analytics/v1`. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="core-analytics/v1"
           xmlns:m09="core-analytics/v1"
           elementFormDefault="qualified">

  <xs:element name="categorySpend">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="categoryId" type="xs:integer"/>
        <xs:element name="categoryName" type="xs:string"/>
        <xs:element name="totalSpend" type="xs:decimal"/>
        <xs:element name="units" type="xs:decimal"/>
        <xs:element name="basketCount" type="xs:integer"/>
        <xs:element name="share" type="xs:decimal"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="indicador">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="clave" type="xs:string"/>
        <xs:element name="valor" type="xs:decimal"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="error">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="statusCode" type="xs:integer"/>
        <xs:element name="message" type="xs:string"/>
        <xs:element name="code" type="xs:string"/>
        <xs:element name="path" type="xs:string"/>
        <xs:element name="timestamp" type="xs:dateTime"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
