<?xml version="1.0" encoding="UTF-8"?>
<!-- Contrato XML de pricing-service (Fase A). Espacio de nombres fijo `pricing/v1`.
     Los endpoints responden esta envoltura cuando `Accept: application/xml`. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="pricing/v1"
           xmlns:pri="pricing/v1"
           elementFormDefault="qualified">

  <xs:simpleType name="priceOrigin">
    <xs:restriction base="xs:string">
      <xs:enumeration value="interno"/>
      <xs:enumeration value="propuesta_proveedor_aprobada"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="presentationSummary">
    <xs:sequence>
      <xs:element name="id" type="xs:string"/>
      <xs:element name="productoId" type="xs:string"/>
      <xs:element name="nombre" type="xs:string"/>
      <xs:element name="contenido" type="xs:decimal"/>
      <xs:element name="unidadMedida" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="zoneSummary">
    <xs:sequence>
      <xs:element name="id" type="xs:string"/>
      <xs:element name="nombre" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="storeSummary">
    <xs:sequence>
      <xs:element name="id" type="xs:string"/>
      <xs:element name="nombre" type="xs:string"/>
      <xs:element name="zonaId" type="xs:string"/>
      <xs:element name="zona" type="pri:zoneSummary"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="price">
    <xs:sequence>
      <xs:element name="id" type="xs:string"/>
      <xs:element name="presentationId" type="xs:string"/>
      <xs:element name="storeId" type="xs:string"/>
      <xs:element name="price" type="xs:decimal"/>
      <xs:element name="effectiveDate" type="xs:date"/>
      <!-- Ausente o vacío = precio vigente -->
      <xs:element name="effectiveUntil" type="xs:date" minOccurs="0"/>
      <xs:element name="vigente" type="xs:boolean"/>
      <xs:element name="origen" type="pri:priceOrigin"/>
      <xs:element name="createdBy" type="xs:string" minOccurs="0"/>
      <xs:element name="createdAt" type="xs:dateTime"/>
      <xs:element name="presentation" type="pri:presentationSummary"/>
      <xs:element name="store" type="pri:storeSummary"/>
    </xs:sequence>
  </xs:complexType>

  <!-- POST /v1/prices -->
  <xs:element name="priceRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="presentationId" type="xs:string"/>
        <xs:element name="storeId" type="xs:string"/>
        <xs:element name="price">
          <xs:simpleType>
            <xs:restriction base="xs:decimal">
              <xs:minExclusive value="0"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="effectiveDate" type="xs:date" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- POST /v1/prices (201) -->
  <xs:element name="priceResponse" type="pri:price"/>

  <!-- GET /v1/prices/history (paginado, ver paginacion.md) -->
  <xs:element name="priceListResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="data">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="item" type="pri:price" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="total" type="xs:integer"/>
        <xs:element name="page" type="xs:integer"/>
        <xs:element name="limit" type="xs:integer"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- GET /v1/prices/compare-zones (agregado, sin paginar) -->
  <xs:complexType name="zonePriceComparison">
    <xs:sequence>
      <xs:element name="zoneId" type="xs:string"/>
      <xs:element name="zoneName" type="xs:string"/>
      <xs:element name="presentationId" type="xs:string"/>
      <xs:element name="presentationName" type="xs:string"/>
      <xs:element name="averagePrice" type="xs:decimal"/>
      <xs:element name="minPrice" type="xs:decimal"/>
      <xs:element name="maxPrice" type="xs:decimal"/>
      <xs:element name="storeCount" type="xs:integer"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="zoneUnitPriceComparison">
    <xs:sequence>
      <xs:element name="zoneId" type="xs:string"/>
      <xs:element name="zoneName" type="xs:string"/>
      <xs:element name="baseUnit" type="xs:string"/>
      <xs:element name="averagePricePerBaseUnit" type="xs:decimal"/>
      <xs:element name="minPricePerBaseUnit" type="xs:decimal"/>
      <xs:element name="maxPricePerBaseUnit" type="xs:decimal"/>
      <xs:element name="storeCount" type="xs:integer"/>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="priceComparisonResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="productId" type="xs:string"/>
        <xs:element name="zones">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="item" type="pri:zonePriceComparison" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="perUnit">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="item" type="pri:zoneUnitPriceComparison" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- GET /v1/prices/series (PRI-11): sin paginar, por eso no lleva page/limit -->
  <xs:element name="priceSeriesResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="data">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="item" type="pri:price" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="total" type="xs:integer"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- GET/PUT /v1/prices/alert-settings (PRI-07, D-09) -->
  <xs:element name="priceAlertSettingsResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="umbralPct" type="xs:decimal"/>
        <xs:element name="ventanaDias" type="xs:integer"/>
        <xs:element name="updatedBy" type="xs:string" minOccurs="0"/>
        <xs:element name="updatedAt" type="xs:dateTime" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- ===== /v1/price-observations (PRI-09, D-16) ===== -->

  <xs:complexType name="observationPresentation">
    <xs:sequence>
      <xs:element name="id" type="xs:string"/>
      <xs:element name="productoId" type="xs:string"/>
      <xs:element name="nombre" type="xs:string"/>
      <xs:element name="producto">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="sku" type="xs:string"/>
            <xs:element name="nombre" type="xs:string"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="observationStore">
    <xs:sequence>
      <xs:element name="id" type="xs:string"/>
      <xs:element name="nombre" type="xs:string"/>
      <xs:element name="zonaId" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Nulos se omiten en XML (lat, lng, rejectionReason, reviewedBy, reviewedAt, priceId). -->
  <xs:complexType name="priceObservation">
    <xs:sequence>
      <xs:element name="id" type="xs:string"/>
      <xs:element name="presentationId" type="xs:string"/>
      <xs:element name="storeId" type="xs:string"/>
      <xs:element name="price" type="xs:decimal"/>
      <xs:element name="observedAt" type="xs:dateTime"/>
      <xs:element name="lat" type="xs:decimal" minOccurs="0"/>
      <xs:element name="lng" type="xs:decimal" minOccurs="0"/>
      <xs:element name="status" type="pri:proposalStatus"/>
      <xs:element name="origin" type="xs:string"/>
      <xs:element name="rejectionReason" type="xs:string" minOccurs="0"/>
      <xs:element name="capturedBy" type="xs:string"/>
      <xs:element name="reviewedBy" type="xs:string" minOccurs="0"/>
      <xs:element name="reviewedAt" type="xs:dateTime" minOccurs="0"/>
      <xs:element name="priceId" type="xs:string" minOccurs="0"/>
      <xs:element name="createdAt" type="xs:dateTime"/>
      <xs:element name="presentation" type="pri:observationPresentation"/>
      <xs:element name="store" type="pri:observationStore"/>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="priceObservationResponse" type="pri:priceObservation"/>

  <xs:element name="priceObservationListResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="data">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="item" type="pri:priceObservation" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="total" type="xs:integer"/>
        <xs:element name="page" type="xs:integer"/>
        <xs:element name="limit" type="xs:integer"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- ===== /v1/price-proposals (RN-14) ===== -->

  <xs:simpleType name="proposalStatus">
    <xs:restriction base="xs:string">
      <xs:enumeration value="pendiente"/>
      <xs:enumeration value="aprobado"/>
      <xs:enumeration value="rechazado"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="proposalProduct">
    <xs:sequence>
      <xs:element name="sku" type="xs:string"/>
      <xs:element name="nombre" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="proposalPresentation">
    <xs:sequence>
      <xs:element name="id" type="xs:string"/>
      <xs:element name="productoId" type="xs:string"/>
      <xs:element name="nombre" type="xs:string"/>
      <xs:element name="contenido" type="xs:decimal"/>
      <xs:element name="unidadMedida" type="xs:string"/>
      <xs:element name="producto" type="pri:proposalProduct"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="proposalSupplier">
    <xs:sequence>
      <xs:element name="id" type="xs:string"/>
      <xs:element name="razonSocial" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="priceProposal">
    <xs:sequence>
      <xs:element name="id" type="xs:string"/>
      <xs:element name="presentationId" type="xs:string"/>
      <xs:element name="supplierId" type="xs:string"/>
      <xs:element name="proposedPrice" type="xs:decimal"/>
      <xs:element name="purchaseUnit" type="xs:string" minOccurs="0"/>
      <xs:element name="status" type="pri:proposalStatus"/>
      <xs:element name="rejectionReason" type="xs:string" minOccurs="0"/>
      <xs:element name="reviewedBy" type="xs:string" minOccurs="0"/>
      <xs:element name="reviewedAt" type="xs:dateTime" minOccurs="0"/>
      <xs:element name="createdAt" type="xs:dateTime"/>
      <xs:element name="presentation" type="pri:proposalPresentation"/>
      <xs:element name="supplier" type="pri:proposalSupplier"/>
    </xs:sequence>
  </xs:complexType>

  <!-- POST /v1/price-proposals -->
  <xs:element name="priceProposalRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="presentationId" type="xs:string"/>
        <xs:element name="proposedPrice">
          <xs:simpleType>
            <xs:restriction base="xs:decimal">
              <xs:minExclusive value="0"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="purchaseUnit" minOccurs="0">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:maxLength value="30"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- POST (201) y PATCH reject (200) -->
  <xs:element name="priceProposalResponse" type="pri:priceProposal"/>

  <!-- GET /v1/price-proposals (paginado) -->
  <xs:element name="priceProposalListResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="data">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="item" type="pri:priceProposal" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="total" type="xs:integer"/>
        <xs:element name="page" type="xs:integer"/>
        <xs:element name="limit" type="xs:integer"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- PATCH /v1/price-proposals/:id/approve -->
  <xs:element name="priceProposalApproveRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="storeIds">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="item" type="xs:string" minOccurs="1" maxOccurs="50"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="effectiveDate" type="xs:date" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="priceProposalApproveResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="proposal" type="pri:priceProposal"/>
        <xs:element name="prices">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="item" type="pri:price" minOccurs="1" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- PATCH /v1/price-proposals/:id/reject -->
  <xs:element name="priceProposalRejectRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="rejectionReason">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:minLength value="10"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="error">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="statusCode" type="xs:integer"/>
        <xs:element name="message" type="xs:string"/>
        <xs:element name="code" type="xs:string"/>
        <!-- Detalle por campo de los 400 del ValidationPipe. Opcional: los
             demas errores lo omiten. Se agrego para que el XML lleve el
             MISMO cuerpo que el JSON (`details` incluido), porque un 400
             sin detalle no es accionable para el cliente XML-exclusivo. -->
        <xs:element name="details" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="item" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="path" type="xs:string"/>
        <xs:element name="timestamp" type="xs:dateTime"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
