<?xml version="1.0" encoding="UTF-8"?>
<!-- M06 paso 2: POST /v1/transactions/import/confirm (200).
     Resumen de lo REALMENTE insertado: cada folio entra completo
     (venta + líneas + canasta en una transacción de base de datos) o se
     reporta en `omitidos` con su motivo. `errores` son las filas que la
     validación rechazó en el preview y por tanto nunca se insertaron. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="unqualified">
  <xs:include schemaLocation="_comun.xsd"/>
  <xs:element name="response">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="importacionId" type="xs:string"/>
        <!-- `confirmado` solo si no quedaron filas pendientes; si la
             confirmación se interrumpió, conserva su estado anterior para
             que un reintento pueda terminarla. -->
        <xs:element name="estado" type="xs:string"/>
        <xs:element name="filasTotales" type="xs:integer"/>
        <xs:element name="filasValidas" type="xs:integer"/>
        <xs:element name="filasConError" type="xs:integer"/>
        <xs:element name="lineasInsertadas" type="xs:integer"/>
        <xs:element name="transaccionesCreadas" type="xs:integer"/>
        <xs:element name="canastasCreadas" type="xs:integer"/>
        <!-- Acumulado en la base, no solo lo de esta pasada. -->
        <xs:element name="transaccionesTotales" type="xs:integer"/>
        <xs:element name="filasPendientes" type="xs:integer"/>
        <xs:element name="completa" type="xs:boolean"/>
        <xs:element name="omitidos">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="item" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="folio" type="xs:string"/>
                    <xs:element name="tienda" type="xs:string"/>
                    <xs:element name="tiendaId" type="xs:string"/>
                    <xs:element name="motivo" type="xs:string"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="errores">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="item" type="importError" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
