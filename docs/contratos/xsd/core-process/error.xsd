<?xml version="1.0" encoding="UTF-8"?>
<!-- Cuerpo de error de CUALQUIER endpoint de core-process-service con
     `Accept: application/xml`. El HttpErrorFilter también respeta Accept,
     así que el cliente XML-exclusivo recibe sus 400/401/403/404/409/413/
     415/500/503 en XML, con esta misma forma. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="unqualified">
  <xs:include schemaLocation="_comun.xsd"/>
  <xs:element name="response" type="errorBody"/>
</xs:schema>
