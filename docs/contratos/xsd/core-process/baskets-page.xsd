<?xml version="1.0" encoding="UTF-8"?>
<!-- M07: GET /v1/baskets con filtros combinables (AND) y paginación:
     storeId, zoneId, segmentId, dateFrom, dateTo, minTotalValue,
     maxTotalValue, minProductCount, maxProductCount, hasBasicProducts,
     size (chica|mediana|grande), page, limit. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="unqualified">
  <xs:include schemaLocation="_comun.xsd"/>
  <xs:element name="response">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="data">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="item" type="basket" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="total" type="xs:integer"/>
        <xs:element name="page" type="xs:integer"/>
        <xs:element name="limit" type="xs:integer"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
