<?xml version="1.0" encoding="UTF-8"?>
<!-- Contrato XML de audit-service (Fase A). Espacio de nombres fijo `audit/v1`. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="audit/v1"
           xmlns:audit="audit/v1"
           elementFormDefault="qualified">

  <!-- `usuarioId`/`rolId` NO están aquí: el actor siempre sale del token
       de `SessionGuard`, nunca del cuerpo. -->
  <xs:element name="eventoRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="tabla" type="xs:string"/>
        <xs:element name="registroId" type="xs:string" minOccurs="0"/>
        <xs:element name="servicio" type="xs:string"/>
        <xs:element name="accion" type="audit:accion"/>
        <xs:element name="descripcion" type="xs:string" minOccurs="0"/>
        <xs:element name="cambios" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="cambio" type="audit:cambio" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="ip" type="xs:string" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:simpleType name="accion">
    <xs:restriction base="xs:string">
      <xs:enumeration value="insert"/>
      <xs:enumeration value="update"/>
      <xs:enumeration value="delete"/>
      <xs:enumeration value="login"/>
      <xs:enumeration value="importacion"/>
      <xs:enumeration value="aprobar"/>
      <xs:enumeration value="rechazar"/>
      <xs:enumeration value="desactivar"/>
      <xs:enumeration value="ejecutar_corrida"/>
      <xs:enumeration value="simular"/>
      <xs:enumeration value="generar_recomendacion"/>
      <xs:enumeration value="exportar"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="cambio">
    <xs:sequence>
      <xs:element name="campo" type="xs:string"/>
      <xs:element name="previo" type="xs:string" minOccurs="0"/>
      <xs:element name="posterior" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Respuesta de POST /v1/auditoria: id numérico (como string, es bigint). -->
  <xs:element name="auditCreateResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="id" type="xs:string"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- GET /v1/auditoria: bitácora paginada, de la más reciente a la más antigua. -->
  <xs:element name="auditListResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="data">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="item" type="audit:evento" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="total" type="xs:integer"/>
        <xs:element name="page" type="xs:integer"/>
        <xs:element name="limit" type="xs:integer"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- GET /v1/auditoria/:id: un solo evento, misma forma que un `item` de la lista. -->
  <xs:element name="auditEventResponse" type="audit:evento"/>

  <!-- Orden exacto de las propiedades del entity `Auditoria` (xs:sequence es
       estricto con el orden de emisión del XmlInterceptor). `usuarioId`/
       `rolId` SIEMPRE salen del token (ver `eventoRequest`), pero sí viajan
       en la RESPUESTA: son el actor registrado, no algo que el cliente
       pueda falsificar al escribir. -->
  <xs:complexType name="evento">
    <xs:sequence>
      <xs:element name="id" type="xs:string"/>
      <xs:element name="usuarioId" type="xs:string" minOccurs="0"/>
      <xs:element name="rolId" type="xs:integer" minOccurs="0"/>
      <xs:element name="tablaAfectada" type="xs:string"/>
      <xs:element name="registroId" type="xs:string" minOccurs="0"/>
      <xs:element name="servicio" type="xs:string"/>
      <xs:element name="accion" type="audit:accion"/>
      <xs:element name="descripcion" type="xs:string" minOccurs="0"/>
      <xs:element name="direccionIp" type="xs:string" minOccurs="0"/>
      <xs:element name="fecha" type="xs:dateTime"/>
      <xs:element name="cambios" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="item" type="audit:cambioRegistrado" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- Orden exacto de las propiedades del entity `AuditoriaCambio`. -->
  <xs:complexType name="cambioRegistrado">
    <xs:sequence>
      <xs:element name="auditoriaId" type="xs:string"/>
      <xs:element name="campo" type="xs:string"/>
      <xs:element name="valorPrevio" type="xs:string" minOccurs="0"/>
      <xs:element name="valorPosterior" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="error">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="statusCode" type="xs:integer"/>
        <xs:element name="message" type="xs:string"/>
        <xs:element name="code" type="xs:string"/>
        <!-- Detalle por campo de los 400 del ValidationPipe. Opcional: los
             demas errores lo omiten. Se agrego para que el XML lleve el
             MISMO cuerpo que el JSON (`details` incluido), porque un 400
             sin detalle no es accionable para el cliente XML-exclusivo. -->
        <xs:element name="details" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="item" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="path" type="xs:string"/>
        <xs:element name="timestamp" type="xs:dateTime"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
