<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:api="ingestion/v1" targetNamespace="ingestion/v1"
           elementFormDefault="qualified">
  <xs:include schemaLocation="xsd/error-transversal.xsd"/>
  <xs:simpleType name="positiveMoney">
    <xs:restriction base="xs:decimal">
      <xs:minExclusive value="0"/>
      <xs:fractionDigits value="2"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="folio">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
      <xs:maxLength value="40"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="generation">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]+"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="sha256">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9a-f]{64}"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="uuid">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="format">
    <xs:restriction base="xs:string">
      <xs:enumeration value="csv"/>
      <xs:enumeration value="json"/>
      <xs:enumeration value="xml"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="batchState">
    <xs:restriction base="xs:string">
      <xs:enumeration value="vista_previa"/>
      <xs:enumeration value="confirmando"/>
      <xs:enumeration value="conciliacion"/>
      <xs:enumeration value="confirmado"/>
      <xs:enumeration value="descartado"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="rowState">
    <xs:restriction base="xs:string">
      <xs:enumeration value="valida"/>
      <xs:enumeration value="repetida"/>
      <xs:enumeration value="rechazada"/>
      <xs:enumeration value="conflicto"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="saleLine">
    <xs:sequence>
      <xs:element name="folio" type="api:folio"/>
      <xs:element name="fecha" type="xs:date"/>
      <xs:element name="tienda" type="xs:string"/>
      <xs:element name="sku" type="xs:string"/>
      <xs:element name="presentacion" type="xs:string"/>
      <xs:element name="cantidad" type="api:positiveMoney"/>
      <xs:element name="precio" type="api:positiveMoney"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="salesFileType">
    <xs:sequence>
      <xs:element name="rows"><xs:complexType><xs:sequence><xs:element name="item" type="api:saleLine" maxOccurs="unbounded"/></xs:sequence></xs:complexType></xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="objectImportType">
    <xs:sequence>
      <xs:element name="objectKey" type="xs:string"/>
      <xs:element name="generation" type="api:generation"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="countsType">
    <xs:sequence>
      <xs:element name="valid" type="xs:nonNegativeInteger"/>
      <xs:element name="repeated" type="xs:nonNegativeInteger"/>
      <xs:element name="rejected" type="xs:nonNegativeInteger"/>
      <xs:element name="conflicts" type="xs:nonNegativeInteger"/>
      <xs:element name="inserted" type="xs:nonNegativeInteger"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="importType">
    <xs:sequence>
      <xs:element name="id" type="api:uuid"/>
      <xs:element name="state" type="api:batchState"/>
      <xs:element name="format" type="api:format"/>
      <xs:element name="sha256" type="api:sha256"/>
      <xs:element name="sizeBytes" type="xs:positiveInteger"/>
      <xs:element name="createdAt" type="xs:dateTime"/>
      <xs:element name="counts" type="api:countsType"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="rowType">
    <xs:sequence>
      <xs:element name="row" type="xs:positiveInteger"/>
      <xs:element name="status" type="api:rowState"/>
      <xs:element name="code" type="xs:string" minOccurs="0"/>
      <xs:element name="message" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="batchPage">
    <xs:sequence>
      <xs:element name="data"><xs:complexType><xs:sequence><xs:element name="item" type="api:importType" minOccurs="0" maxOccurs="unbounded"/></xs:sequence></xs:complexType></xs:element>
      <xs:element name="total" type="xs:nonNegativeInteger"/>
      <xs:element name="page" type="xs:positiveInteger"/>
      <xs:element name="limit" type="xs:positiveInteger"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="rowPage">
    <xs:sequence>
      <xs:element name="data"><xs:complexType><xs:sequence><xs:element name="item" type="api:rowType" minOccurs="0" maxOccurs="unbounded"/></xs:sequence></xs:complexType></xs:element>
      <xs:element name="total" type="xs:nonNegativeInteger"/>
      <xs:element name="page" type="xs:positiveInteger"/>
      <xs:element name="limit" type="xs:positiveInteger"/>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="salesFile" type="api:salesFileType"/>
  <xs:element name="objectImport" type="api:objectImportType"/>
  <xs:element name="transactionImport" type="api:importType"/>
  <xs:element name="transactionImports" type="api:batchPage"/>
  <xs:element name="transactionImportRows" type="api:rowPage"/>
</xs:schema>
