<?xml version="1.0" encoding="UTF-8"?>
<!-- Contrato XML de decision-service (Fase A). Espacio `decision/v1`. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="decision/v1"
           xmlns:dec="decision/v1"
           elementFormDefault="qualified">

  <xs:element name="indiceAccesibilidad">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="zoneId" type="xs:string"/>
        <xs:element name="segmentId" type="xs:integer"/>
        <xs:element name="basicBasketCost" type="xs:decimal"/>
        <xs:element name="estimatedIncome" type="xs:decimal" minOccurs="0"/>
        <xs:element name="indexValue" type="xs:decimal"/>
        <xs:element name="calculatedAt" type="xs:dateTime" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="simulacionPrecioRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="presentationId" type="xs:string"/>
        <xs:element name="zoneId" type="xs:string"/>
        <xs:element name="newPrice" type="xs:decimal"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="simulacionPresentacionRequest">
    <xs:complexType>
      <xs:all>
        <xs:element name="productId" type="xs:string"/>
        <xs:element name="zoneId" type="xs:string" minOccurs="0"/>
        <xs:element name="presentationIds" type="dec:ListaTexto" minOccurs="0"/>
      </xs:all>
    </xs:complexType>
  </xs:element>

  <xs:element name="resultadoItem">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="indicatorKey" type="xs:string"/>
        <xs:element name="zoneId" type="xs:string" minOccurs="0"/>
        <xs:element name="baseValue" type="xs:decimal"/>
        <xs:element name="simulatedValue" type="xs:decimal"/>
        <xs:element name="variacionPct" type="xs:decimal" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="recomendacionRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="zoneId" type="xs:string" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- GET /v1/recommendations/:id/explain. `xs:all`: no depende del orden
       en que el servicio arme los campos. -->
  <xs:element name="recomendacion">
    <xs:complexType>
      <xs:all>
        <xs:element name="recommendationId" type="xs:string" minOccurs="0"/>
        <xs:element name="title" type="xs:string"/>
        <xs:element name="whatRecommends" type="xs:string"/>
        <xs:element name="why" type="xs:string"/>
        <xs:element name="estimatedImpact" type="xs:string"/>
        <!-- Lista: el interceptor XML la envuelve como <evidence><item>…
             Sin evidencia sale <evidence></evidence>, sin ningún <item>. -->
        <xs:element name="evidence">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="item" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:all>
                    <xs:element name="dimension" type="xs:string"/>
                    <xs:element name="referenceId" type="xs:string"/>
                    <xs:element name="description" type="xs:string"/>
                  </xs:all>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="status" type="xs:string"/>
        <xs:element name="generatedAt" type="xs:dateTime"/>
      </xs:all>
    </xs:complexType>
  </xs:element>

  <!-- POST /v1/recommendations/generate. El arreglo de la raíz sale como
       <recomendacionesResponse><item>…; sin recomendaciones, la raíz va
       vacía. Cada <item> es la recomendación tal como se guardó (mismos
       campos que el JSON), NO la forma de `recomendacion` (explain). Los
       tres ids son opcionales porque un nulo se omite en el XML. -->
  <xs:element name="recomendacionesResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="item" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:all>
              <xs:element name="id" type="xs:string"/>
              <xs:element name="corridaId" type="xs:string" minOccurs="0"/>
              <xs:element name="escenarioId" type="xs:string" minOccurs="0"/>
              <xs:element name="zonaId" type="xs:string" minOccurs="0"/>
              <xs:element name="titulo" type="xs:string"/>
              <xs:element name="queRecomienda" type="xs:string"/>
              <xs:element name="porQue" type="xs:string"/>
              <xs:element name="impactoEstimado" type="xs:string"/>
              <xs:element name="estatus" type="xs:string"/>
              <xs:element name="generadaEn" type="xs:dateTime"/>
            </xs:all>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="error">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="statusCode" type="xs:integer"/>
        <xs:element name="message" type="xs:string"/>
        <xs:element name="code" type="xs:string"/>
        <!-- Detalle por campo de los 400 del ValidationPipe. Opcional: los
             demas errores lo omiten. Se agrego para que el XML lleve el
             MISMO cuerpo que el JSON (`details` incluido), porque un 400
             sin detalle no es accionable para el cliente XML-exclusivo. -->
        <xs:element name="details" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="item" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="path" type="xs:string"/>
        <xs:element name="timestamp" type="xs:dateTime"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

    <!-- ===== Tipos reutilizables de simulacion ===== -->

  <xs:complexType name="ListaTexto">
    <xs:sequence>
      <xs:element name="item" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ResultadoIndicador">
    <xs:all>
      <xs:element name="indicatorKey" type="xs:string"/>
      <xs:element name="zoneId" type="xs:string" minOccurs="0"/>
      <xs:element name="baseValue" type="xs:decimal"/>
      <xs:element name="simulatedValue" type="xs:decimal"/>
      <xs:element name="variationPct" type="xs:decimal" minOccurs="0"/>
      <xs:element name="difference" type="xs:decimal" minOccurs="0"/>
    </xs:all>
  </xs:complexType>

  <xs:complexType name="ListaResultados">
    <xs:sequence>
      <xs:element name="item" type="dec:ResultadoIndicador" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="EfectoAccesibilidad">
    <xs:all>
      <xs:element name="incomeSharePct" type="xs:decimal" minOccurs="0"/>
      <xs:element name="unitPricePremiumPct" type="xs:decimal" minOccurs="0"/>
    </xs:all>
  </xs:complexType>

  <xs:complexType name="PresentacionEvaluada">
    <xs:all>
      <xs:element name="presentationId" type="xs:string"/>
      <xs:element name="presentationName" type="xs:string"/>
      <xs:element name="baseUnit" type="xs:string" minOccurs="0"/>
      <xs:element name="priceStatus" type="xs:string"/>
      <xs:element name="outlay" type="xs:decimal" minOccurs="0"/>
      <xs:element name="unitPrice" type="xs:decimal" minOccurs="0"/>
      <xs:element name="estimatedDemand" type="xs:decimal" minOccurs="0"/>
      <xs:element name="accessibilityEffect" type="dec:EfectoAccesibilidad" minOccurs="0"/>
    </xs:all>
  </xs:complexType>

  <xs:complexType name="ListaPresentaciones">
    <xs:sequence>
      <xs:element name="item" type="dec:PresentacionEvaluada" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="EscenarioResumen">
    <xs:all>
      <xs:element name="id" type="xs:string"/>
      <xs:element name="name" type="xs:string"/>
      <xs:element name="type" type="xs:string"/>
      <xs:element name="zoneId" type="xs:string" minOccurs="0"/>
      <xs:element name="productId" type="xs:string" minOccurs="0"/>
      <xs:element name="presentationId" type="xs:string" minOccurs="0"/>
      <xs:element name="elasticity" type="xs:decimal" minOccurs="0"/>
      <xs:element name="elasticityRunId" type="xs:string" minOccurs="0"/>
      <xs:element name="currentPrice" type="xs:decimal" minOccurs="0"/>
      <xs:element name="newPrice" type="xs:decimal" minOccurs="0"/>
      <xs:element name="baseDemand" type="xs:decimal" minOccurs="0"/>
      <xs:element name="presentations" type="dec:ListaPresentaciones" minOccurs="0"/>
      <xs:element name="assumptions" type="dec:ListaTexto" minOccurs="0"/>
      <xs:element name="createdBy" type="xs:string" minOccurs="0"/>
      <xs:element name="createdAt" type="xs:dateTime" minOccurs="0"/>
    </xs:all>
  </xs:complexType>

  <xs:complexType name="ListaEscenarios">
    <xs:sequence>
      <xs:element name="item" type="dec:EscenarioResumen" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="EscenarioComparado">
    <xs:all>
      <xs:element name="scenarioId" type="xs:string"/>
      <xs:element name="name" type="xs:string"/>
      <xs:element name="type" type="xs:string"/>
      <xs:element name="zoneId" type="xs:string" minOccurs="0"/>
      <xs:element name="elasticity" type="xs:decimal" minOccurs="0"/>
      <xs:element name="elasticityRunId" type="xs:string" minOccurs="0"/>
      <xs:element name="results" type="dec:ListaResultados" minOccurs="0"/>
    </xs:all>
  </xs:complexType>

  <xs:complexType name="ListaEscenariosComparados">
    <xs:sequence>
      <xs:element name="item" type="dec:EscenarioComparado" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="simulacionEscenariosResponse">
    <xs:complexType>
      <xs:all>
        <xs:element name="data" type="dec:ListaEscenarios" minOccurs="0"/>
        <xs:element name="total" type="xs:integer"/>
        <xs:element name="page" type="xs:integer"/>
        <xs:element name="limit" type="xs:integer"/>
      </xs:all>
    </xs:complexType>
  </xs:element>

  <xs:element name="simulacionCompareResponse">
    <xs:complexType>
      <xs:all>
        <xs:element name="scenarioIds" type="dec:ListaTexto"/>
        <xs:element name="scenarios" type="dec:ListaEscenariosComparados"/>
        <xs:element name="warnings" type="dec:ListaTexto" minOccurs="0"/>
      </xs:all>
    </xs:complexType>
  </xs:element>

  <xs:element name="simulacionPresentacionResponse">
    <xs:complexType>
      <xs:all>
        <xs:element name="type" type="xs:string"/>
        <xs:element name="scenarioId" type="xs:string"/>
        <xs:element name="productId" type="xs:string"/>
        <xs:element name="productName" type="xs:string"/>
        <xs:element name="zoneId" type="xs:string" minOccurs="0"/>
        <xs:element name="segmentId" type="xs:integer" minOccurs="0"/>
        <xs:element name="presentations" type="dec:ListaPresentaciones"/>
        <xs:element name="referencePresentationId" type="xs:string" minOccurs="0"/>
        <xs:element name="comparedPresentationId" type="xs:string" minOccurs="0"/>
        <xs:element name="results" type="dec:ListaResultados" minOccurs="0"/>
        <xs:element name="assumptions" type="dec:ListaTexto" minOccurs="0"/>
        <xs:element name="warnings" type="dec:ListaTexto" minOccurs="0"/>
      </xs:all>
    </xs:complexType>
  </xs:element>

</xs:schema>
