# --- Servidor (lo fija docker-compose) ---
PORT=3114
SERVICE_NAME=availability-service
SERVICE_VERSION=1.0.0
# targetNamespace de docs/contratos/availability-service.xsd
XML_NAMESPACE=availability/v1

# --- JWT (mismo secreto en todos los servicios en local; GCP: Secret Manager) ---
JWT_ACCESS_SECRET=dev_access_secret_solo_para_local

# --- Redis (sesión activa: lo consulta el SessionGuard en cada petición) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- PostgreSQL compartido (este servicio solo escribe inventario y
#     disponibilidad_capturas) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=retail_user
DB_PASSWORD=retail_pass_2026
DB_NAME=retaildb

# --- Otros servicios (por HTTP, con el token y el id de correlación de quien llama) ---
# Canasta básica (productos y presentaciones), tiendas y zonas.
CATALOG_SERVICE_URL=http://localhost:3102
# Bitácora: sin bloquear; si no responde, la operación igual se completa.
AUDIT_SERVICE_URL=http://localhost:3110

# --- D-38: un dato de existencia vale 7 días; después sale como vencido ---
AVAILABILITY_VALID_DAYS=7
