# --- Servidor (lo fija docker-compose por servicio) ---
PORT=3119
SERVICE_NAME=data-governance-service
SERVICE_VERSION=1.0.0
# Namespace del XSD (docs/contratos/data-governance-service.xsd)
XML_NAMESPACE=governance/v1

# --- JWT (mismo secreto en todos los servicios en local; GCP: Secret Manager) ---
JWT_ACCESS_SECRET=dev_access_secret_solo_para_local

# --- Redis: solo la sesión (sesion_actual) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- PostgreSQL compartido: SOLO sus tablas (fuentes_datos, fuente_versiones, linaje_registros,
#     linaje_insumos, politicas_retencion). Migración: db/migraciones/sprint4_data_governance.sql ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=retail_user
DB_PASSWORD=retail_pass_2026
DB_NAME=retaildb

# --- Calidad y retención (3 s; un dueño que no responde deja SU fuente disponible:false, no un 503) ---
INGESTION_SERVICE_URL=http://localhost:3111
CORE_PROCESS_SERVICE_URL=http://localhost:3104
AVAILABILITY_SERVICE_URL=http://localhost:3114
INCOME_SEGMENTATION_SERVICE_URL=http://localhost:3112

# --- Bitácora de altas y cambios de fuentes y versiones (no bloqueante) ---
AUDIT_SERVICE_URL=http://localhost:3110

# --- Reglas del dominio (DG-8, contrato data-governance-service.md) ---
FRESHNESS_SALES_DAYS=7
FRESHNESS_SEGMENTS_DAYS=365

# Sin MongoDB (el health lo reporta "no configurado").
