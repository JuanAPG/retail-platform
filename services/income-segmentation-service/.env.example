# --- Servidor (lo fija docker-compose) ---
PORT=3112
SERVICE_NAME=income-segmentation-service
SERVICE_VERSION=1.0.0
# targetNamespace de docs/contratos/income-segmentation-service.xsd
XML_NAMESPACE=segmentation/v1

# --- JWT (mismo secreto en todos los servicios en local; GCP: Secret Manager) ---
JWT_ACCESS_SECRET=dev_access_secret_solo_para_local

# --- Redis (sesión activa: lo consulta el SessionGuard en cada petición) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- PostgreSQL compartido (este servicio solo escribe segmentos_ingreso,
#     segmento_versiones y zona_clasificaciones) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=retail_user
DB_PASSWORD=retail_pass_2026
DB_NAME=retaildb

# --- Otros servicios (por HTTP, con el token y el id de correlación de quien llama) ---
# Valida que la zona exista y lista las tiendas de cada zona.
CATALOG_SERVICE_URL=http://localhost:3102
# Cuenta transacciones y da el ticket promedio por zona (D-36).
CORE_PROCESS_SERVICE_URL=http://localhost:3104
# Bitácora: sin bloquear; si no responde, la operación igual se completa.
AUDIT_SERVICE_URL=http://localhost:3110

# --- D-36: mínimo de datos para publicar un agregado zona-segmento ---
PUBLICATION_MIN_TRANSACTIONS=10
PUBLICATION_MIN_STORES=3
# P-11 PENDIENTE: `ambos` (hacen falta las dos condiciones; no publica en la
# duda) o `cualquiera` (basta una). Se cambia aquí cuando el PO lo decida.
PUBLICATION_RULE=ambos
