# --- Servidor (lo fija docker-compose por servicio) ---
PORT=3106
SERVICE_NAME=analytics-stats
SERVICE_VERSION=1.0.0
# Namespace del XSD (docs/contratos/analytics-stats.xsd)
XML_NAMESPACE=stats/v1

# --- JWT (mismo secreto en los 10 servicios en local; GCP: Secret Manager) ---
JWT_ACCESS_SECRET=dev_access_secret_solo_para_local

# --- Redis (sesiones, revocados, caché, rate-limit) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Servicios que consulta por HTTP (modo baskets, clustering) ---
CORE_PROCESS_SERVICE_URL=http://localhost:3104
CATALOG_SERVICE_URL=http://localhost:3102

# --- MongoDB: corridas de clustering (D3) ---
MONGO_URL=mongodb://retail_admin:retail_pass_2026@localhost:27017/retaildb?authSource=admin

# --- Auth (analytics-stats solo valida; auth-service emite) ---
AUTH_SERVICE_URL=http://localhost:3001

# --- PostgreSQL compartido (cada servicio solo escribe SUS tablas) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=retail_user
DB_PASSWORD=retail_pass_2026
DB_NAME=retaildb
