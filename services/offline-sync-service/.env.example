# --- Servidor (lo fija docker-compose) ---
PORT=3118
SERVICE_NAME=offline-sync-service
SERVICE_VERSION=1.0.0
# targetNamespace del XSD: el XmlInterceptor lo pone como xmlns en la raíz.
XML_NAMESPACE=sync/v1

# --- JWT (mismo secreto en todos los servicios en local; GCP: Secret Manager) ---
JWT_ACCESS_SECRET=cambia-por-el-secreto-local-del-compose

# --- Redis: sesiones (SessionGuard), candado, idempotencia y último estado (D-47) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- MongoDB: colecciones lotes_sync y capturas_sync (D-47) ---
# En el compose lleva usuario y contraseña de Mongo: viene del entorno, no se escribe aquí.
MONGO_URL=mongodb://localhost:27017
MONGO_DB=retaildb
# D-43: capturas de campo se retienen 1 año (índice TTL).
SYNC_RETENCION_DIAS=365

# --- Días locales de los filtros dateFrom/dateTo ---
BUSINESS_TIMEZONE=America/Monterrey

# --- Auditoría y avisos (no bloqueantes; vacíos = no se envían) ---
AUDIT_SERVICE_URL=http://localhost:3110
NOTIFICATIONS_SERVICE_URL=http://localhost:3109

# --- Auth (lo usa la plantilla como respaldo; la sesión se valida en Redis) ---
AUTH_SERVICE_URL=http://localhost:3101
