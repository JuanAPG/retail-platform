{
  "name": "offline-sync-service",
  "version": "1.0.0",
  "private": true,
  "description": "Sincronización de capturas hechas sin conexión: lotes, acuse por captura, idempotencia y conflictos (T-17, D-42, D-47).",
  "scripts": {
    "build": "nest build -p tsconfig.build.json",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "test": "jest --testPathIgnorePatterns=test/",
    "test:integracion": "jest --config ./test/jest.integracion.json"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/swagger": "^7.4.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "fast-xml-parser": "^4.5.0",
    "ioredis": "^5.4.1",
    "mongodb": "^6.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "xmllint-wasm": "^5.3.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/testing": "^10.4.22",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.9",
    "jest": "^29.7.0",
    "jsonwebtoken": "^9.0.3",
    "ts-jest": "^29.4.14",
    "typescript": "^5.5.4"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
