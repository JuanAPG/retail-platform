# --- Servidor (lo fija docker-compose por servicio) ---
PORT=3116
SERVICE_NAME=demand-forecast-service
SERVICE_VERSION=1.0.0
# Namespace del XSD (docs/contratos/demand-forecast-service.xsd)
XML_NAMESPACE=forecast/v1

# --- JWT (mismo secreto en todos los servicios en local; GCP: Secret Manager) ---
JWT_ACCESS_SECRET=dev_access_secret_solo_para_local

# --- Redis: solo la sesión (sesion_actual) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- MongoDB: corridas de pronóstico, colección forecast_runs (D-47) ---
MONGO_URL=mongodb://retail_admin:retail_pass_2026@localhost:27017/retaildb?authSource=admin

# --- Lecturas por HTTP (3 s; si no responden → 503) ---
CATALOG_SERVICE_URL=http://localhost:3102
CORE_PROCESS_SERVICE_URL=http://localhost:3104

# --- Bitácora, aviso y linaje: no bloqueantes; sin la variable no se envía ---
AUDIT_SERVICE_URL=http://localhost:3110
NOTIFICATIONS_SERVICE_URL=http://localhost:3109
DATA_GOVERNANCE_SERVICE_URL=http://localhost:3119

# --- Reglas del dominio (contrato demand-forecast-service.md) ---
# DF-5: periodo estacional en semanas (≈ un mes)
SEASONAL_PERIOD=4
# DF-8 / P-11: "ambos" (10 transacciones Y 3 tiendas) o "cualquiera"
PUBLICATION_RULE=ambos

# Sin PostgreSQL: el servicio no lee ni escribe tablas (el health lo reporta "no configurado").
