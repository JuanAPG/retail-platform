# --- Servidor (lo fija docker-compose) ---
PORT=3117
SERVICE_NAME=recommendations-workflow-service
SERVICE_VERSION=1.0.0
# targetNamespace del XSD (docs/contratos/recommendations-workflow-service.xsd).
XML_NAMESPACE=workflow/v1

# --- JWT (mismo secreto en todos los servicios en local; GCP: Secret Manager) ---
JWT_ACCESS_SECRET=dev_access_secret_solo_para_local

# --- Redis: solo la sesión (SessionGuard); la idempotencia de la asignación es la llave única ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- PostgreSQL: recomendacion_seguimientos y seguimiento_eventos (db/migraciones/sprint4_recommendations_workflow.sql) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=retail_user
DB_PASSWORD=retail_pass_2026
DB_NAME=retaildb

# --- Días locales de dueDate, implementedOn y periodos (contrato §3) ---
BUSINESS_TIMEZONE=America/Monterrey

# --- decision-service (obligatoria: sin ella el servicio no arranca) ---
# Nombre del compose (red interna). Fuera de Docker: http://localhost:3107.
DECISION_SERVICE_URL=http://decision-service:3107

# --- Auditoría y avisos (no bloqueantes, 1.5 s; vacías = no se envían y quedan no_aplica) ---
AUDIT_SERVICE_URL=http://audit-service:3110
NOTIFICATIONS_SERVICE_URL=http://notifications-service:3109

# --- Auth (respaldo de la plantilla; la sesión se valida en Redis) ---
AUTH_SERVICE_URL=http://auth-service:3101
