# --- Servidor (lo fija docker-compose) ---
PORT=3115
SERVICE_NAME=promotion-service
SERVICE_VERSION=1.0.0
# targetNamespace del XSD (docs/contratos/promotion-service.xsd): el XmlInterceptor lo pone como xmlns en la raíz.
XML_NAMESPACE=promotion/v1

# --- JWT (mismo secreto en todos los servicios en local; GCP: Secret Manager) ---
JWT_ACCESS_SECRET=dev_access_secret_solo_para_local

# --- Redis: solo la sesión (SessionGuard) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- PostgreSQL: tablas promociones y promocion_eventos (db/migraciones/sprint4_promotion.sql) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=retail_user
DB_PASSWORD=retail_pass_2026
DB_NAME=retaildb

# --- Días locales de validFrom / validTo / validity (contrato §3) ---
BUSINESS_TIMEZONE=America/Monterrey

# --- Lecturas por HTTP (obligatorias: sin ellas el servicio no arranca) ---
# Nombres del compose (red interna). Fuera de Docker: http://localhost:3102 y http://localhost:3103.
CATALOG_SERVICE_URL=http://catalog-service:3102
PRICING_SERVICE_URL=http://pricing-service:3103

# --- Auditoría y avisos (no bloqueantes, 1.5 s; vacías = no se envían y quedan no_aplica) ---
AUDIT_SERVICE_URL=http://audit-service:3110
NOTIFICATIONS_SERVICE_URL=http://notifications-service:3109

# --- Auth (respaldo de la plantilla; la sesión se valida en Redis) ---
AUTH_SERVICE_URL=http://auth-service:3101
