# --- Servidor (lo fija docker-compose por servicio) ---
PORT=3103
SERVICE_NAME=pricing-service
SERVICE_VERSION=1.0.0

# --- JWT (mismo secreto en los 10 servicios en local; GCP: Secret Manager) ---
JWT_ACCESS_SECRET=dev_access_secret_solo_para_local

# --- Redis (sesiones, revocados, caché, rate-limit) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Auth (solo lo usan los 9 servicios que validan; auth-service emite) ---
AUTH_SERVICE_URL=http://localhost:3101

# --- Auditoría (el servicio reporta eventos; si no responde, la operación sigue) ---
AUDIT_SERVICE_URL=http://localhost:3110

# --- PostgreSQL compartido (cada servicio solo escribe SUS tablas) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=retail_user
DB_PASSWORD=retail_pass_2026
DB_NAME=retaildb
