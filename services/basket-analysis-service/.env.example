# --- Servidor (lo fija docker-compose por servicio) ---
PORT=3113
SERVICE_NAME=basket-analysis-service
SERVICE_VERSION=1.0.0
# Namespace del XSD (docs/contratos/basket-analysis-service.xsd)
XML_NAMESPACE=basket-analysis/v1

# --- JWT (mismo secreto en todos los servicios en local; GCP: Secret Manager) ---
JWT_ACCESS_SECRET=dev_access_secret_solo_para_local

# --- Redis: solo la sesión (sesion_actual) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Lecturas por HTTP (3 s; si no responden → 503) ---
CORE_PROCESS_SERVICE_URL=http://localhost:3104
CATALOG_SERVICE_URL=http://localhost:3102
INCOME_SEGMENTATION_SERVICE_URL=http://localhost:3112

# --- Reglas del dominio (contrato basket-analysis-service.md) ---
# BA-5 / P-11: "ambos" (10 transacciones Y 3 tiendas) o "cualquiera"
PUBLICATION_RULE=ambos

# Sin PostgreSQL ni MongoDB: calcula al vuelo y no guarda resultados (el health los reporta "no configurado").
