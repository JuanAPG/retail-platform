# URL del auth-service. Copia este archivo como .env y ajusta si hace falta.
#
# OJO: esta URL la resuelve el NAVEGADOR de quien abre la página, no el
# servidor donde corre el front. Solo sirve "localhost" cuando el backend
# corre en la misma máquina desde la que estás navegando.
VITE_API_URL=http://localhost:3001

# Backend desplegado en la VM de GCP (usar la IP externa actual de la VM):
# VITE_API_URL=http://34.51.117.148:3001
#
# Vite lee esta variable al ARRANCAR: después de cambiarla hay que reiniciar
# `npm run dev`, o volver a correr `npm run build` si se sirve el dist/.
