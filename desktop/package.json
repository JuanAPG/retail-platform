{
  "name": "retail-decision-desktop",
  "version": "0.1.0",
  "description": "App de escritorio para analistas (Retail Platform) — Electron + React + TypeScript, habla XML con los microservicios.",
  "main": "dist-electron/main.js",
  "author": "Fernando Olivares del Valle",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && electron-builder",
    "build:unpacked": "tsc -b && vite build && electron-builder --dir",
    "preview": "vite preview",
    "build:electron": "tsc -p tsconfig.node.json",
    "electron:dev": "npm run build:electron && concurrently -k \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\""
  },
  "dependencies": {
    "axios": "^1.7.2",
    "fast-xml-parser": "^4.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.25.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.2.1",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.udem.retaildecision.desktop",
    "productName": "Retail Decision Desktop",
    "files": ["dist/**/*", "dist-electron/**/*"],
    "directories": { "output": "release" },
    "mac": { "target": "dmg", "category": "public.app-category.business" },
    "win": { "target": "nsis" },
    "linux": { "target": "AppImage", "category": "Office" }
  }
}
