# URLs de los microservicios que consume la app de escritorio, una por servicio.
# Vite las lee según el modo:
#   npm run dev / electron:dev  -> .env.development (HTTP local, ya incluido)
#   npm run build:staging       -> .env.staging     (HTTPS, marcadores PENDIENTE-GCP)
#   npm run build               -> .env.production  (HTTPS, marcadores PENDIENTE-GCP)
# Para cambiar una URL solo en tu máquina, crea .env.development.local (no se sube).
# El build de staging/producción FALLA si una URL no es https://, apunta a localhost o lleva puerto.

VITE_AUTH_URL=http://localhost:3101/            # auth-service
VITE_CATALOG_URL=http://localhost:3102/         # catalog-service
VITE_ALGORITHMS_URL=http://localhost:3105/      # algorithms-core
VITE_DECISION_URL=http://localhost:3107/        # decision-service
VITE_DOCUMENTS_URL=http://localhost:3108/       # documents-service
VITE_INGESTION_URL=http://localhost:3111/       # transactions-ingestion-service
VITE_SEGMENTATION_URL=http://localhost:3112/    # income-segmentation-service
VITE_PROMOTION_URL=http://localhost:3115/       # promotion-service
VITE_WORKFLOW_URL=http://localhost:3117/        # recommendations-workflow-service
