{$STAGING_HOST} {
	encode zstd gzip
	log {
		format json
	}

	@interno {
		path_regexp privado ^/api/[^/]+/v1/(health/?$|transactions/internal(/|$))
	}
	@eventoInterno {
		method POST
		path /api/audit-service/v1/auditoria /api/audit-service/v1/auditoria/ /api/notifications-service/v1/notifications /api/notifications-service/v1/notifications/
	}
	@versionado path_regexp api ^/api/([a-z-]+)(/v1/.*)$
	@api path /api /api/*

	map {re.api.1} {service_port} {
		auth-service 3101
		catalog-service 3102
		pricing-service 3103
		core-process-service 3104
		algorithms-core 3105
		analytics-stats 3106
		decision-service 3107
		documents-service 3108
		notifications-service 3109
		audit-service 3110
		transactions-ingestion-service 3111
		income-segmentation-service 3112
		basket-analysis-service 3113
		availability-service 3114
		promotion-service 3115
		demand-forecast-service 3116
		recommendations-workflow-service 3117
		offline-sync-service 3118
		data-governance-service 3119
		monitoring-service 3120
		default 0
	}

	route {
		respond @interno 404
		respond @eventoInterno 404
		handle @versionado {
			@sinServicio expression `{service_port} == "0"`
			respond @sinServicio 404
			rewrite * {re.api.2}
			reverse_proxy {re.api.1}:{service_port}
		}
		respond @api 404
		handle {
			root * /srv/web
			try_files {path} /index.html
			file_server
		}
	}
}
