<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Hablar con los microservicios -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Indicador de conectividad (requisito explícito del backlog) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- RF-34: escaneo de código de barras -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="true" />
    <!-- RF-37: ubicación de la tienda -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:name=".RetailDecisionApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.RetailDecision"
        android:usesCleartextTraffic="true">
        <!--
          usesCleartextTraffic="true" es SOLO para desarrollo contra el
          emulador/localhost (http://10.0.2.2). Antes de producción esto se
          quita y el backend expone HTTPS real.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.RetailDecision">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Worker de sincronización en background (RF-39) -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge" />

    </application>

</manifest>
